{
  "name": "@local/dsh-statusbar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A living terminal strip that takes over the composer status cells: breathing accent glow, rotating status phrase, token-flow beads, real session figures and a click wave.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "styles/*.css",
    "scripts/*.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
